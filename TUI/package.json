{
  "name": "@dsh-toolset/tui",
  "version": "0.1.0",
  "private": true,
  "description": "DSH (DeepSeek Harness) 进程内集成终端 UI",
  "type": "module",
  "bin": {
    "tui": "./bin/tui.js"
  },
  "main": "dist/src/main.js",
  "scripts": {
    "bench": "node --experimental-transform-types bench/layout-bench.mts",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "demo": "node dist/demo/main.js",
    "demo:build": "pnpm run build && node dist/demo/main.js",
    "gen:width-table": "node scripts/gen-width-table.mts",
    "smoke:pty": "node demo/smokePty.mjs",
    "test": "sh scripts/test.sh",
    "test:coverage": "rm -rf ../tmp/cov-tui && mkdir -p ../tmp/cov-tui && NODE_V8_COVERAGE=../tmp/cov-tui node --experimental-transform-types --test 'tests/*.test.ts' 'tests/integration/*.test.ts' && sleep 1 && node ../dev/coverage/report.mjs tmp/cov-tui tmp/cov-tui/report.json",
    "test:e2e": "pnpm run demo:build -- --smoke && pnpm run smoke:pty",
    "test:integration": "node --experimental-transform-types --test 'tests/integration/*.test.ts'",
    "watch": "tsc -p tsconfig.json --watch"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist",
    "bin",
    "LICENSE",
    "README.md",
    "cordis.patch.yml",
    "tui.config.json"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "types": "./dist/src/main.d.ts"
}
