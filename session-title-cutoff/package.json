{
  "name": "@dsh-toolset/session-title-cutoff",
  "version": "0.1.0",
  "description": "DSH（DeepSeek Harness）会话标题插件：all-prompts 触发不变，参考窗口改为「最近一次 git commit 之后」的人类消息",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-transform-types --test 'tests/*.test.ts'"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
