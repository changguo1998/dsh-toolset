{
  "name": "@dsh-toolset/task-engine",
  "version": "0.1.0",
  "private": true,
  "description": "DSH（DeepSeek Harness）任务树引擎：Frame 状态机、decompose/implement/stop/status 工具族、机械门禁与 RET 验收路由",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "demo": "pnpm run build && node dist/demo/main.js",
    "smoke:executor": "pnpm run build && node scripts/executor-smoke.mjs",
    "test": "node --experimental-transform-types --test 'tests/*.test.ts'"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
