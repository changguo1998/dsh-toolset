{
  "name": "@dsh-toolset/memory-base",
  "version": "0.1.0",
  "description": "DSH (DeepSeek Harness) 进程内集成分层记忆存储：S / P / U 三层库、按扩展隔离的写入句柄与全局只读查询",
  "type": "module",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-transform-types --test 'tests/*.test.ts'",
    "demo": "node --experimental-transform-types demo/main.ts",
    "smoke": "node smoke/smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
