{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "lib": [
            "ES2022"
        ],
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "rootDir": ".",
        "outDir": "dist",
        "declaration": false,
        "sourceMap": true,
        "rewriteRelativeImportExtensions": true,
        "verbatimModuleSyntax": true,
        "types": [
            "node"
        ]
    },
    "include": [
        "src",
        "demo",
        "tests"
    ]
}
