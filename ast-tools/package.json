{
  "name": "@dsh-toolset/ast-tools",
  "version": "0.1.0",
  "private": true,
  "description": "DSH (DeepSeek Harness) 进程内集成插件：ast-grep AST 结构搜索/替换/大纲/规则",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-transform-types --test 'tests/*.test.ts'",
    "test:integration": "node --experimental-transform-types --test 'tests/integration/*.test.ts'",
    "test:coverage": "rm -rf ../tmp/cov-ast-tools && mkdir -p ../tmp/cov-ast-tools && NODE_V8_COVERAGE=\"../tmp/cov-ast-tools\" node --experimental-transform-types --test 'tests/*.test.ts' 'tests/integration/*.test.ts' && node ../dev/coverage/report.mjs tmp/cov-ast-tools tmp/cov-ast-tools/report.json",
    "example:search": "node --experimental-transform-types examples/search.example.ts",
    "example:replace": "node --experimental-transform-types examples/replace.example.ts"
  },
  "dependencies": {
    "@dsh-toolset/clock-base": "link:../clock-base",
    "@dsh-toolset/tool-surface": "link:../tool-surface"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
