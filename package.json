{
  "name": "dsh-toolset",
  "version": "0.1.0",
  "private": true,
  "description": "DSH（DeepSeek Harness）进程内集成插件工具集",
  "scripts": {
    "check": "TEST_SCRIPT=check sh scripts/test-parallel.sh",
    "build": "TEST_SCRIPT=build sh scripts/test-parallel.sh",
    "test": "sh scripts/test-parallel.sh",
    "test:integration": "TEST_SCRIPT=test:integration sh scripts/test-parallel.sh",
    "test:e2e": "node --experimental-transform-types --test --test-force-exit --test-concurrency=4 'e2e/*.test.ts'",
    "test:e2e:tui": "TEST_SCRIPT=test:e2e sh scripts/test-parallel.sh TUI",
    "test:coverage": "node dev/coverage/collect.mjs && node dev/coverage/report.mjs",
    "check:docs": "node dev/standard/index.mjs",
    "check:docs:strict": "node dev/standard/index.mjs --strict",
    "demo": "pnpm -C TUI run demo --",
    "test:tui": "sh TUI/scripts/test.sh",
    "test:smoke": "sh scripts/run-smoke.sh"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.2.2-rc.1"
  },
  "pnpm": {
    "verifyDepsBeforeRun": false
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
