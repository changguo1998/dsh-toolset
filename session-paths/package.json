{
  "name": "@dsh-toolset/session-paths",
  "version": "0.1.0",
  "description": "DSH（DeepSeek Harness）会话目录编码插件：复刻宿主的 projectKey / encodeSegment 并以服务 sessionPaths 供其他插件共用",
  "type": "module",
  "main": "dist/src/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tests/tsconfig.json",
    "test": "node --experimental-transform-types --test 'tests/*.test.ts'"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
