{
  "name": "@dsh-toolset/command-template",
  "version": "0.1.0",
  "description": "DSH（DeepSeek Harness）模板体系插件：slash 命令模板（pre-steps / chain / best-of-N + 模板级模型选择），模板双源（仓库随包 + 用户目录）",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-transform-types --test 'tests/*.test.ts'"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist",
    "templates",
    "LICENSE",
    "README.md",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
