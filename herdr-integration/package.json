{
    "name": "@dsh-toolset/herdr-integration",
    "version": "0.1.0",
    "description": "DSH (DeepSeek Harness) 与 herdr 面板集成：agent 状态经 unix socket 上报、blocked 事件桥（ask-user / approval）",
    "type": "module",
    "main": "dist/src/main.js",
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "check": "tsc -p tsconfig.json --noEmit",
        "test": "node --experimental-transform-types --test 'tests/*.test.ts'",
        "watch": "tsc -p tsconfig.json --watch"
    },
    "dependencies": {},
    "devDependencies": {
        "@types/node": "^24.13.3",
        "typescript": "^5.9.3"
    },
    "files": [
        "dist",
        "README.md",
        "cordis.patch.yml"
    ],
    "engines": {
        "node": ">=22.19.0"
    },
    "dsh": {
        "bundle": {
            "patch": "./cordis.patch.yml"
        }
    }
}
